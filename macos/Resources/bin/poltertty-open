#!/usr/bin/env bash
# macos/Resources/bin/poltertty-open
# Called by yazi when user opens a file. Opens a new tab in the current workspace
# via the Ctrl API. Falls back to system 'open' if Ctrl API is unavailable.
set -euo pipefail

if [ $# -eq 0 ]; then
    echo "Usage: poltertty-open <path>" >&2
    exit 1
fi

FILE_PATH="$1"

if [ -z "${POLTERTTY_CTRL_PORT:-}" ]; then
    open "$FILE_PATH"
    exit 0
fi

# Use python3 for safe JSON serialization (avoids shell injection via file paths)
JSON=$(python3 -c "
import json, sys
cmd = (sys.argv[1] or 'vim') + ' ' + sys.argv[2]
print(json.dumps({'command': cmd}))
" "${EDITOR:-vim}" "$FILE_PATH" 2>/dev/null) || {
    open "$FILE_PATH"
    exit 0
}

curl -s -X POST "http://localhost:${POLTERTTY_CTRL_PORT}/api/new_tab" \
    -H "Content-Type: application/json" \
    -d "$JSON" >/dev/null 2>&1 || open "$FILE_PATH"
